# MongoDB Configuration
# For production, replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/workspace-app?retryWrites=true&w=majority

# JWT Configuration
# Generate a secure random key for production (minimum 64 characters for HS512)
JWT_SECRET=WorkspaceAppSecretKeyForJWTToken2023ExtraLongSecureKeyForHS512AlgorithmCompliance2024
JWT_EXPIRATION_MS=86400000

# VideoSDK Configuration
# Get your API key and secret from https://app.videosdk.live
VIDEOSDK_API_KEY=your-videosdk-api-key
VIDEOSDK_SECRET=your-videosdk-secret
VIDEOSDK_TOKEN_TTL=15

# Server Configuration (optional)
SERVER_PORT=8080
